# Copy to deploy/nebius.env. Never commit real secrets.
NEBIUS_ENV=production
NEBIUS_PUBLIC_URL=https://nebius.example.com
NEBIUS_TRUST_PROXY=1
NEBIUS_SIGNING_SECRET=            # 32+ random bytes (openssl rand -base64 32); else one is generated and stored in the DB
# Storage: local (default) or s3
NEBIUS_STORAGE=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
CLAMDSCAN_PATH=                   # e.g. /usr/bin/clamdscan to enable malware scanning
# Mail (verification, reset, invitations)
MAIL_TRANSPORT=http
MAIL_HTTP_ENDPOINT=
MAIL_HTTP_API_KEY=
MAIL_FROM=NEBIUS <no-reply@example.com>
# Notebooks (docker mode builds deploy/jupyter.Dockerfile as nebius-jupyter:local)
NEBIUS_JUPYTER_MODE=docker
# Approx AI pipeline source
APPROX_REPO_URL=https://github.com/umer630/Approx-Ai
# Free GPU providers (optional)
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
NEBIUS_PYTHON=python3
# Inference server hosting a VERIFIED adapter (OpenAI-compatible, e.g. vLLM)
NEBIUS_INFERENCE_URL=
NEBIUS_INFERENCE_API_KEY=
